{
  "$schema_comment": "Harness hooks. Run by the harness, not the agent: they cannot be bypassed. Paths use harness/ (symlink to the toolkit's lib/). sandbox (I3c, WARN phase, docs/design/I3c-sandbox.md): opt-in per project, off here; a project switches it on with sandbox.enabled true in .claude/settings.local.json, and then Claude's Bash runs in Claude Code's native sandbox under the rest of this block: denyWrite is enforced by the kernel, so expansions, Python, make recipes and scripts cannot write the harness-owned paths. The harness writers (gates, close, issues lane) are excludedCommands: they write progress/ and commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/guard_write.sh\"",
            "description": "Blocks writes to tests/acceptance/ (Codex oracle), Codex verdicts, and src/ outside the approved plan scope.",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/guard_bash.sh\"",
            "description": "Blocks Claude commits, agent attribution, and shell writes to protected paths.",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/post_write.sh\"",
            "description": "Fast feedback: lint + tests after each write (does not block).",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/stop_gate.sh\"",
            "description": "Before closing: make check (verify + invariants + gate consistency).",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "$comment": "allow: the harness targets and the Python toolchain run without a prompt; anything else (make -f, uv run <program>, …) asks. deny: what the Bash guard always blocks for Claude, with no escape valve (I8), and the Edit(...) rules for the paths Claude never writes with a file tool (I3c: Edit rules cover Edit, Write, MultiEdit and NotebookEdit; Write(...) rules are ignored by Claude Code).",
    "allow": [
      "Bash(make check)",
      "Bash(make verify)",
      "Bash(make lint)",
      "Bash(make lint:*)",
      "Bash(make type)",
      "Bash(make test)",
      "Bash(make plan)",
      "Bash(make status)",
      "Bash(make status-export)",
      "Bash(make issue:*)",
      "Bash(make issue-start:*)",
      "Bash(make issue-new:*)",
      "Bash(make env-check)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(./harness/review_with_codex.sh:*)",
      "Bash(./harness/check.sh)"
    ],
    "deny": [
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(patch:*)",
      "Bash(./harness/review_with_codex.sh seal:*)",
      "Bash(./harness/legacy_inventory.sh create:*)",
      "Bash(./harness/legacy_inventory.sh review:*)",
      "Bash(./harness/legacy_inventory.sh seal:*)",
      "Edit(/harness/**)",
      "Edit(/.claude/**)",
      "Edit(/tests/acceptance/**)",
      "Edit(/harness.toml)",
      "Edit(/.harness/**)",
      "Edit(/.git/harness-*)",
      "Edit(/.git/harness-*/**)",
      "Edit(/progress/review_*.md)",
      "Edit(/progress/*_review_*.md)",
      "Edit(/progress/*_review.md)",
      "Edit(/progress/task_close_*.md)",
      "Edit(/progress/phase_close_*.md)",
      "Edit(/progress/close_*.msg)",
      "Edit(/progress/*.sha256)",
      "Edit(/progress/pr_*.md)",
      "Edit(/progress/review_history/**)",
      "Edit(/progress/*_baseline.json)",
      "Edit(/progress/legacy_inventory.json)",
      "Edit(/progress/task_flow_legacy_*.json)",
      "Edit(/progress/issue_migrations_*.json)",
      "Edit(/progress/oracle_migrations/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "./harness/review_with_codex.sh *",
      "harness/review_with_codex.sh *",
      "./harness/issue.sh *",
      "harness/issue.sh *",
      "make issue *",
      "make issue-start *",
      "make issue-new",
      "make plan",
      "python3 harness/_contract.py contract-propose",
      "python3 harness/_contract.py contract-propose *",
      "python3 harness/_oracle.py contract-propose",
      "python3 harness/_oracle.py contract-propose *",
      "python3 harness/_oracle.py replan-history *",
      "tail *",
      "head *"
    ],
    "filesystem": {
      "denyWrite": [
        "./progress",
        "./harness",
        "./.claude",
        "./tests/acceptance",
        "./harness.toml",
        "./.harness"
      ],
      "allowWrite": [
        "~/.cache/uv",
        "~/.codex"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "chatgpt.com",
        "ab.chatgpt.com",
        "api.openai.com",
        "auth.openai.com"
      ]
    }
  }
}
