{
  "$schema_comment": "Harness hooks. Run by the harness, not the agent: they cannot be bypassed. Paths use harness/ (symlink to the toolkit's lib/).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/guard_write.sh\"",
            "description": "Blocks writes to tests/acceptance/ (Codex oracle), Codex verdicts, and src/ outside the approved plan scope.",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/guard_bash.sh\"",
            "description": "Blocks Claude commits, agent attribution, and shell writes to protected paths.",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/post_write.sh\"",
            "description": "Fast feedback: lint + tests after each write (does not block).",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/stop_gate.sh\"",
            "description": "Before closing: make check (verify + invariants + gate consistency).",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "$comment": "allow: the harness targets and the Python toolchain run without a prompt; anything else (make -f, uv run <program>, …) asks. deny: what the Bash guard always blocks for Claude, with no escape valve (I8).",
    "allow": [
      "Bash(make check)",
      "Bash(make verify)",
      "Bash(make lint)",
      "Bash(make lint:*)",
      "Bash(make type)",
      "Bash(make test)",
      "Bash(make plan)",
      "Bash(make status)",
      "Bash(make status-export)",
      "Bash(make issue:*)",
      "Bash(make issue-start:*)",
      "Bash(make issue-new:*)",
      "Bash(make env-check)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(./harness/review_with_codex.sh:*)",
      "Bash(./harness/check.sh)"
    ],
    "deny": [
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(patch:*)",
      "Bash(./harness/review_with_codex.sh seal:*)",
      "Bash(./harness/legacy_inventory.sh create:*)",
      "Bash(./harness/legacy_inventory.sh review:*)",
      "Bash(./harness/legacy_inventory.sh seal:*)"
    ]
  }
}
